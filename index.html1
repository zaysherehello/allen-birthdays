<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Happy Birthday Allen ♡</title>

<style>
* {
  box-sizing: border-box;
}

html, body {
  margin: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  font-family: "Trebuchet MS", Arial, sans-serif;
  color: #4b3d3b;
  bac

#app {
  width: 100vw;
  height: 100vh;
  position: relative;
  overflow: hidden;
}

.scene {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  opacity: 0;
  transform: translateX(30px);
  pointer-events: none;
  transition: opacity .6s ease, transform .6s ease;
  z-index: 1;
}

.scene.active {
  opacity: 1;
  transform: translateX(0);
  pointer-events: auto;
}

.card {
  position: relative;
  z-index: 10;
  width: min(92vw, 650px);
  max-height: 90vh;
  overflow-y: auto;
  padding: 28px;
  text-align: center;
  background: #fffaf3;
  border: 2px dashed #9b7b70;
  border-radius: 28px;
  box-shadow: 0 15px 40px rgba(80,50,40,.15);
}

h1 {
  font-size: clamp(38px, 10vw, 62px);
  margin: 12px 0;
}

h2 {
  font-size: clamp(27px, 7vw, 44px);
  margin: 10px 0;
}

p {
  font-size: clamp(16px, 4.5vw, 21px);
  line-height: 1.5;
}

.btn {
  border: 0;
  border-radius: 999px;
  padding: 14px 23px;
  margin: 8px;
  background: #6d9b78;
  color: white;
  font-size: 16px;
  cursor: pointer;
  box-shadow: 0 5px 0 #4f7659;
  position: relative;
  z-index: 20;
}

.btn:active {
  transform: translateY(4px);
  box-shadow: 0 1px 0 #4f7659;
}

.choice {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 9px;
}

.choice button {
  padding: 11px 15px;
  border: 2px solid #876d65;
  border-radius: 17px;
  background: #fffaf3;
  cursor: pointer;
  position: relative;
  z-index: 20;
}

.small {
  font-size: 14px;
  opacity: .7;
}

#barWrap {
  position: absolute;
  top: 8px;
  left: 10px;
  right: 10px;
  height: 5px;
  background: rgba(255,255,255,.6);
  z-index: 100;
  border-radius: 10px;
}

#bar {
  width: 0%;
  height: 100%;
  background: #6d9b78;
  transition: .5s;
}

/* Park */

.park {
  position: absolute;
  inset: 0;
  z-index: -1;
  background: linear-gradient(#dcebdc 0 57%, #b9d6a7 57%);
  pointer-events: none;
}

.sun {
  position: absolute;
  width: 90px;
  height: 90px;
  border-radius: 50%;
  background: #f2ce82;
  top: 8%;
  right: 8%;
  z-index: 0;
  pointer-events: none;
}

.tree {
  position: absolute;
  font-size: 70px;
  z-index: 0;
  pointer-events: none;
}

.tree1 {
  left: 3%;
  top: 18%;
}

.tree2 {
  right: 3%;
  top: 23%;
}

.pond {
  width: min(520px, 88vw);
  height: 170px;
  margin: 15px auto;
  border-radius: 50%;
  background: #a8ced0;
  border: 4px solid #668f91;
  position: relative;
  overflow: hidden;
}

.pond::after {
  content: "🐟   🐟";
  position: absolute;
  left: 35%;
  top: 48%;
  font-size: 26px;
  animation: fish 3s infinite alternate;
}

@keyframes fish {
  from { transform: translateX(-15px); }
  to { transform: translateX(35px); }
}

/* Characters */

.doodle {
  width: 230px;
  height: 180px;
  margin: 10px auto;
  position: relative;
}

.person {
  position: absolute;
  bottom: 5px;
  width: 60px;
  height: 105px;
  border: 4px solid #4b4140;
  border-radius: 32px 32px 20px 20px;
  background: #fff7ec;
}

.person::before {
  content: "";
  position: absolute;
  width: 55px;
  height: 55px;
  left: -1px;
  top: -49px;
  border: 4px solid #4b4140;
  border-radius: 50%;
  background: #f2c5a7;
}

.me {
  left: 30px;
}

.allen {
  right: 30px;
  height: 114px;
  background: #dbe8de;
}

.allen::before {
  background: #c99578;
}

.hand {
  font-size: 65px;
  animation: bounce 1s infinite alternate;
}

@keyframes bounce {
  to { transform: translateY(8px); }
}

.flowers {
  font-size: 32px;
  letter-spacing: 7px;
}

.cat {
  font-size: 70px;
  animation: catWalk 2s infinite alternate;
}

@keyframes catWalk {
  from { transform: translateX(-12px); }
  to { transform: translateX(12px); }
}

.firefly {
  position: absolute;
  font-size: 18px;
  animation: float 3s infinite alternate;
  z-index: 2;
  pointer-events: none;
}

.f1 { left: 12%; top: 30%; }
.f2 { left: 75%; top: 28%; }
.f3 { left: 25%; top: 70%; }
.f4 { right: 12%; top: 65%; }

@keyframes float {
  from {
    transform: translateY(0);
    opacity: .4;
  }
  to {
    transform: translateY(-25px);
    opacity: 1;
  }
}

.gift {
  font-size: 100px;
  cursor: pointer;
  animation: gift 1s infinite alternate;
  position: relative;
  z-index: 20;
}

@keyframes gift {
  to {
    transform: scale(1.08) rotate(2deg);
  }
}

.cake {
  font-size: 100px;
  cursor: pointer;
  position: relative;
  z-index: 20;
}

.skyStar {
  position: absolute;
  color: white;
  font-size: 20px;
  animation: twinkle 1.5s infinite alternate;
  z-index: 2;
  pointer-events: none;
}

.s1 { left: 12%; top: 15%; }
.s2 { left: 35%; top: 10%; }
.s3 { right: 20%; top: 17%; }
.s4 { right: 8%; top: 35%; }
.s5 { left: 22%; top: 35%; }

@keyframes twinkle {
  from { opacity: .3; }
  to { opacity: 1; }
}

.sunset {
  background: linear-gradient(#f2c79f 0 57%, #a9c58f 57%);
}

.night {
  background: linear-gradient(#625b85 0 57%, #687e69 57%);
}

.heart {
  font-size: 70px;
  animation: heart .7s ease;
}

@keyframes heart {
  from { transform: scale(0); }
  to { transform: scale(1); }
}

#toast {
  position: absolute;
  bottom: 22px;
  left: 50%;
  transform: translateX(-50%);
  background: #4b3d3b;
  color: white;
  padding: 10px 17px;
  border-radius: 999px;
  opacity: 0;
  transition: .3s;
  z-index: 200;
  pointer-events: none;
}

#toast.show {
  opacity: 1;
}
</style>
</head>

<body>

<div id="app">

<div id="barWrap">
  <div id="bar"></div>
</div>

<!-- 1 -->
<section class="scene active">
  <div class="card">
    <div class="stars">✦ ♡ ✦</div>

    <h1>Happy Birthday, Allen! ♡</h1>

    <p>
      Today I'm taking you on a little stroll in the park.
    </p>

    <p>
      I know that on your birthdays, you usually go to the park
      with your mom and a popsicle.
    </p>

    <p>
      Since we're far apart, I wanted to make our own little
      birthday park day. ♡
    </p>

    <button class="btn nextBtn">Come with me →</button>
  </div>
</section>

<!-- 2 -->
<section class="scene">
  <div class="card">
    <h2>YOU'RE INVITED! 🌷</h2>

    <p>
      🎟️ PARK ADMISSION
    </p>

    <h2>FREE</h2>

    <p>
      Because the owner loves you. ♡
    </p>

    <div class="doodle">
      <div class="person me"></div>
      <div class="person allen"></div>
    </div>

    <button class="btn nextBtn">Enter the park →</button>
  </div>
</section>

<!-- 3 -->
<section class="scene">
  <div class="card">
    <div class="hand">🫶</div>

    <h2>Do you wanna hold my hand?</h2>

    <p>Put your finger here ♡</p>

    <button class="btn handBtn">Hold my hand</button>
  </div>
</section>

<!-- 4 -->
<section class="scene">
  <div class="park"></div>
  <div class="sun"></div>
  <div class="tree tree1">🌳</div>
  <div class="tree tree2">🌳</div>

  <div class="firefly f1">✨</div>
  <div class="firefly f2">✨</div>
  <div class="firefly f3">✨</div>
  <div class="firefly f4">✨</div>

  <div class="card">
    <h2>Welcome to our park ♡</h2>

    <div class="pond"></div>

    <div class="flowers">
      🌷 🌿 🌼 🌿 🌷
    </div>

    <p>Look! There's the pond.</p>

    <div class="cat">🐈‍⬛</div>

    <p class="small">
      Oh... and apparently we have a tiny visitor.
    </p>

    <button class="btn nextBtn">Let's explore →</button>
  </div>
</section>

<!-- 5 -->
<section class="scene">
  <div class="card">
    <h2>Popsicle time! 🍧</h2>

    <p>
      Just like your usual birthday.
      Except this time I'm getting one for you. ♡
    </p>

    <div class="choice">
      <button class="flavorBtn" data-flavor="Strawberry 🍓">
        🍓 Strawberry
      </button>

      <button class="flavorBtn" data-flavor="Mango 🥭">
        🥭 Mango
      </button>

      <button class="flavorBtn" data-flavor="Lemon 🍋">
        🍋 Lemon
      </button>
    </div>

    <div style="font-size:80px">🍧</div>

    <p id="flavor"></p>

    <button class="btn nextBtn hiddenNext">
      Thank you! ♡ →
    </button>
  </div>
</section>

<!-- 6 -->
<section class="scene">
  <div class="card">
    <h2>A little walk 🌿</h2>

    <div class="doodle">
      <div class="person me"></div>
      <div class="person allen"></div>
    </div>

    <p>
      We're walking around the pond,
      still holding hands. ♡
    </p>

    <div class="choice">
      <button class="messageBtn"
        data-message="The flowers are so pretty. 🌷">
        🌷
      </button>

      <button class="messageBtn"
        data-message="The fish said hello! 🐟">
        🐟
      </button>

      <button class="messageBtn"
        data-message="A bird flew over us! 🐦">
        🐦
      </button>
    </div>

    <p id="parkMessage"></p>

    <button class="btn nextBtn">
      Keep walking →
    </button>
  </div>
</section>

<!-- 7 -->
<section class="scene">
  <div class="card">
    <h2>Wait... one more thing 🎵</h2>

    <p>
      I picked a song for our little walk.
    </p>

    <button class="btn songBtn">
      🎵 Best Friend ♡
    </button>

    <p class="small">
      Best Friend — Rex Orange County
    </p>

    <button class="btn nextBtn">
      Continue →
    </button>
  </div>
</section>

<!-- 8 -->
<section class="scene">
  <div class="park sunset"></div>

  <div class="card">
    <h2>Let's rest for a bit. ♡</h2>

    <div style="font-size:85px">🪑</div>

    <p>
      I know this isn't the same as actually being there...
    </p>

    <p>
      But I wanted to give you a little birthday party of our own.
    </p>

    <p>
      Even though we're far apart,
      I still want to spend your birthday with you. ♡
    </p>

    <button class="btn nextBtn">
      One more thing... →
    </button>
  </div>
</section>

<!-- 9 -->
<section class="scene">
  <div class="card">
    <h2>I brought you something. 🎁</h2>

    <p>Tap the gift.</p>

    <div class="gift">🎁</div>

    <p id="giftMessage"></p>

    <button class="btn nextBtn hiddenNext">
      Open it →
    </button>
  </div>
</section>

<!-- 10 -->
<section class="scene">
  <div class="card">
    <h2>And obviously... CAKE! 🎂</h2>

    <div class="cake">🎂</div>

    <p>
      Tap the cake to blow out the candle.
    </p>

    <p id="cakeMessage"></p>

    <button class="btn nextBtn hiddenNext">
      Make a wish →
    </button>
  </div>
</section>

<!-- 11 -->
<section class="scene">
  <div class="card">
    <div style="font-size:55px">💌</div>

    <h2>A little letter for you</h2>

    <p>Dear Allen,</p>

    <p>
      I hope your birthday is filled with happiness,
      good memories, good food, and lots of reasons to smile.
    </p>

    <p>
      I may not be able to physically walk beside you today,
      but I hope this little place reminds you that someone
      far away is thinking about you.
    </p>

    <p>
      Thank you for being you. ♡
    </p>

    <button class="btn nextBtn">
      Keep going →
    </button>
  </div>
</section>

<!-- 12 -->
<section class="scene">
  <div class="park night"></div>

  <div class="skyStar s1">✦</div>
  <div class="skyStar s2">✧</div>
  <div class="skyStar s3">✦</div>
  <div class="skyStar s4">✧</div>
  <div class="skyStar s5">✦</div>

  <div class="card">
    <h2>It's getting late... 🌙</h2>

    <div style="font-size:70px">🌙</div>

    <p>
      The park is getting quiet.
      The stars are coming out.
    </p>

    <p>
      Maybe we should head home...
    </p>

    <button class="btn nextBtn">
      One last thing →
    </button>
  </div>
</section>

<!-- 13 -->
<section class="scene">
  <div class="card">
    <div class="stars">
      ✦ ✧ ♡ ✧ ✦
    </div>

    <div class="doodle">
      <div class="person me"></div>
      <div class="person allen"></div>
    </div>

    <h2>Happy Birthday, my twin. ♡</h2>

    <p>
      Until we can actually go to the park together,
      I hope this little one makes you smile.
    </p>

    <button class="btn finalBtn">
      Tap our hands ♡
    </button>

    <div id="final"></div>
  </div>
</section>

<div id="toast"></div>

</div>

<script>
document.addEventListener("DOMContentLoaded", function () {

  const scenes = Array.from(document.querySelectorAll(".scene"));
  const bar = document.getElementById("bar");
  const toast = document.getElementById("toast");

  let current = 0;

  function showScene(number) {
    if (number < 0 || number >= scenes.length) return;

    scenes.forEach(function (scene, index) {
      scene.classList.toggle("active", index === number);
    });

    current = number;

    if (bar) {
      const percent = (number / (scenes.length - 1)) * 100;
      bar.style.width = percent + "%";
    }

    window.scrollTo(0, 0);
  }

  function nextScene() {
    if (current < scenes.length - 1) {
      showScene(current + 1);
    }
  }

  function showToast(message) {
    if (!toast) return;

    toast.textContent = message;
    toast.classList.add("show");

    setTimeout(function () {
      toast.classList.remove("show");
    }, 1600);
  }

  /* Next buttons */

  document.querySelectorAll(".nextBtn").forEach(function (button) {
    button.addEventListener("click", nextScene);
  });

  /* Hold hand */

  const handButton = document.querySelector(".handBtn");

  if (handButton) {
    handButton.addEventListener("click", function () {
      showToast("You got my hand 🫶");

      setTimeout(function () {
        nextScene();
      }, 700);
    });
  }

  /* Popsicles */

  document.querySelectorAll(".flavorBtn").forEach(function (button) {
    button.addEventListener("click", function () {

      const flavor = button.dataset.flavor;
      const flavorText = document.getElementById("flavor");

      if (flavorText) {
        flavorText.textContent =
          "You chose " + flavor + " for Allen! ♡";
      }

      const nextButton =
        document.querySelector(".scene.active .hiddenNext");

      if (nextButton) {
        nextButton.style.display = "inline-block";
      }

      showToast("Birthday popsicle acquired! 🍧");
    });
  });

  /* Park messages */

  document.querySelectorAll(".messageBtn").forEach(function (button) {
    button.addEventListener("click", function () {

      const message = button.dataset.message;
      const messageBox = document.getElementById("parkMessage");

      if (messageBox) {
        messageBox.textContent = message;
      }

      showToast("♡");
    });
  });

  /* Music */

  const songButton = document.querySelector(".songBtn");

  if (songButton) {
    songButton.addEventListener("click", function () {
      window.open(
        "https://www.youtube.com/results?search_query=Rex+Orange+County+Best+Friend",
        "_blank"
      );
    });
  }

  /* Gift */

  const gift = document.querySelector(".gift");

  if (gift) {
    gift.addEventListener("click", function () {

      const message = document.getElementById("giftMessage");

      if (message) {
        message.textContent =
          "Inside is a little reminder that you're loved. 💗";
      }

      const nextButton =
        document.querySelector(".scene.active .hiddenNext");

      if (nextButton) {
        nextButton.style.display = "inline-block";
      }

      showToast("A gift just for you 🎁");
    });
  }

  /* Cake */

  const cake = document.querySelector(".cake");

  if (cake) {
    cake.addEventListener("click", function () {

      cake.textContent = "🍰";

      const message = document.getElementById("cakeMessage");

      if (message) {
        message.textContent =
          "The candle is out! Make your birthday wish. ✨";
      }

      const nextButton =
        document.querySelector(".scene.active .hiddenNext");

      if (nextButton) {
        nextButton.style.display = "inline-block";
      }

      showToast("Happy birthday!! 🎂");
    });
  }

  /* Final */

  const finalButton = document.querySelector(".finalBtn");

  if (finalButton) {
    finalButton.addEventListener("click", function () {

      const finalBox = document.getElementById("final");

      if (finalBox) {
        finalBox.innerHTML =
          '<div class="heart">💗</div>' +
          '<p>I’ll always be cheering for you. ♡</p>' +
          '<p>Happy Birthday, Allen.</p>' +
          '<div style="font-size:40px">🌷🫶🌷</div>';
      }

      showToast("A little piece of my heart ♡");
    });
  }

  /* Start */

  showScene(0);

});
</script>

</body>
</html>
